# MEMOSPHERE Environment Configuration
# Copy this file to .env and configure ONLY your chosen AI provider.
# All four providers DO NOT need to be configured simultaneously.
# If no API key is set, MEMOSPHERE automatically uses its built-in privacy-safe rule-based fallback.

FLASK_SECRET_KEY=memosphere-change-this-secret-key-in-production
FLASK_DEBUG=False
PORT=5000

# Select ONE active provider: groq | nvidia_nim | gemini | openai
AI_PROVIDER=groq

# ---------------------------------------------------------------------------
# Provider API keys and models (only the selected AI_PROVIDER key is required)
# Each provider has its OWN model variable, so switching providers never
# carries another provider's model name into the request.
# ---------------------------------------------------------------------------

# Groq — OpenAI-compatible endpoint: https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# NVIDIA NIM — OpenAI-compatible endpoint: https://integrate.api.nvidia.com/v1
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.1-70b-instruct

# Google Gemini — Generative Language REST API (x-goog-api-key header)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI — https://api.openai.com/v1 (or an OpenAI-compatible endpoint)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Deprecated legacy global model override (only applied to Groq for backwards compatibility).
# Prefer the per-provider MODEL variables above.
# AI_MODEL=

# API request timeout in seconds
AI_TIMEOUT_SECONDS=15
