# Memosphere — AI Memory & Dementia Care Companion (Backend Environment)
PORT=8000
DATABASE_PATH=memosphere.db
MEMOSPHERE_SECRET_KEY=change_this_local_secret_key_in_production

# =============================================================================
# AI PROVIDER CONFIGURATION (Backend-Only — NEVER exposed to frontend)
# =============================================================================
# Choose one: gemini, openai, groq, nvidia, nvidia_nim, together, anthropic, custom
AI_PROVIDER=gemini

# Model name (optional - uses provider default if not set)
# AI_MODEL=

# Generation settings
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=600

# =============================================================================
# API KEYS — Add keys for providers you want to use
# =============================================================================
# Google Gemini (https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Groq - Fast inference (https://console.groq.com/keys)
GROQ_API_KEY=

# NVIDIA NIM / NVIDIA API (https://build.nvidia.com/explore/discover)
NVIDIA_API_KEY=

# Together AI (https://api.together.xyz/settings/api-keys)
TOGETHER_API_KEY=

# Anthropic Claude (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# =============================================================================
# CUSTOM PROVIDER (Any OpenAI-compatible endpoint)
# =============================================================================
# CUSTOM_BASE_URL=https://your-custom-endpoint.com/v1
# CUSTOM_MODEL=your-model-name
# CUSTOM_API_KEY=