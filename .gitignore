# MEMOSPHERE — files that must never be committed

# Secrets / local environment
.env
.env.*
!.env.example
.envrc
secrets.*
credentials*.json
*.pem
*.key
*.p12
*.pfx
.npmrc
.pypirc

# Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Python byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class
*.so

# Distribution / packaging / build artifacts
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.spec
target/
out/

# Unit test / coverage reports / caches
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py.cover
*.lcov
.hypothesis/
.pytest_cache/
.mypy_cache/
.dmypy.json
.ruff_cache/
.pyre/
.pytype/
.cython_debug/
tempCodeRunnerFile.py

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pip-log.txt
pip-delete-this-directory.txt

# Local databases (seed data is created by app.py)
*.db
*.db-journal
*.sqlite
*.sqlite3
db.sqlite3
db.sqlite3-journal
instance/
instance/*.db

# Frontend dependencies
node_modules/
bower_components/
.webassets-cache/

